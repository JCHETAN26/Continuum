{
  "name": "continuum",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time embedding drift detection and adaptive fine-tuning platform",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "lint": "pnpm lint:ts && pnpm lint:format && pnpm lint:py",
    "lint:ts": "eslint .",
    "lint:format": "prettier --check .",
    "lint:py": "uv run ruff check . && uv run ruff format --check .",
    "lint:fix": "eslint . --fix && prettier --write . && uv run ruff check --fix . && uv run ruff format .",
    "type-check": "pnpm type-check:ts && pnpm type-check:py",
    "type-check:ts": "pnpm -r --if-present type-check",
    "type-check:py": "uv run mypy",
    "test": "pnpm test:ts && pnpm test:py",
    "test:ts": "pnpm -r --if-present test",
    "test:py": "uv run pytest",
    "build": "pnpm -r --if-present build",
    "db:generate": "pnpm --filter @continuum/shared db:generate",
    "db:migrate": "pnpm --filter @continuum/shared db:migrate",
    "db:studio": "pnpm --filter @continuum/shared db:studio",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "infra:reset": "docker compose --env-file .env -f infra/docker-compose.yml down -v",
    "infra:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f",
    "infra:config": "docker compose -f infra/docker-compose.yml config -q",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
