FROM node:22.13-slim AS builder

WORKDIR /app
# The corepack bundled with node:22.13 carries signing keys that no longer match the
# ones npm serves, so `corepack prepare` dies with "Cannot find matching keyid".
# Updating corepack first picks up the current keys; the pnpm version stays pinned.
RUN npm install -g corepack@latest && corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/dashboard/package.json apps/dashboard/
# Disable strict engine checks for the build
RUN echo "engine-strict=false" > .npmrc

RUN pnpm install --frozen-lockfile

COPY apps/dashboard apps/dashboard

WORKDIR /app/apps/dashboard
RUN pnpm build

FROM node:22.13-slim

WORKDIR /app
COPY --from=builder --chown=node:node /app/apps/dashboard/public ./public
COPY --from=builder --chown=node:node /app/apps/dashboard/.next/standalone ./
COPY --from=builder --chown=node:node /app/apps/dashboard/.next/static ./.next/static

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
USER node
HEALTHCHECK --interval=5s --timeout=3s --retries=20 --start-period=10s \
  CMD node -e 'fetch("http://localhost:3000").then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))'

CMD ["node", "apps/dashboard/server.js"]
