FROM python:3.12-slim as builder

# Install system dependencies
RUN apt-get update && apt-get install -y curl build-essential && rm -rf /var/lib/apt/lists/*

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/usr/local/bin" sh

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY apps/ingest/pyproject.toml apps/ingest/
COPY apps/embedding/pyproject.toml apps/embedding/
COPY apps/drift/pyproject.toml apps/drift/
COPY apps/trainer/pyproject.toml apps/trainer/
COPY apps/server/pyproject.toml apps/server/
COPY packages/shared/python/pyproject.toml packages/shared/python/

# Install dependencies for all workspace members
RUN uv sync --no-install-project

COPY . /app
RUN uv sync

FROM python:3.12-slim

WORKDIR /app
COPY --from=builder /app /app
ENV PATH="/app/.venv/bin:$PATH"

# The command will be overridden by docker-compose for each service
CMD ["python"]
