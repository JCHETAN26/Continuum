# Continuum environment.
#
#   cp .env.example .env
#
# Every value below is a local-development default that matches infra/docker-compose.yml.
# None of them are secrets. Real deployments inject these from a secret manager; nothing in
# this file is ever safe to reuse outside a laptop.
#
# All of these are validated at process startup — see packages/shared/src/config.ts (TypeScript)
# and packages/shared/python/continuum_shared/config.py (Python). A missing or malformed
# value crashes the service immediately rather than failing on first use.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Postgres (pgvector)
# ---------------------------------------------------------------------------
POSTGRES_USER=continuum
POSTGRES_PASSWORD=continuum
POSTGRES_DB=continuum
POSTGRES_PORT=55432

DATABASE_URL=postgresql://continuum:continuum@localhost:55432/continuum?schema=public
# Used only by `prisma migrate dev`, which needs a throwaway database to diff against.
SHADOW_DATABASE_URL=postgresql://continuum:continuum@localhost:55432/continuum_shadow?schema=public

# ---------------------------------------------------------------------------
# Kafka (Redpanda)
# ---------------------------------------------------------------------------
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=continuum
REDPANDA_KAFKA_PORT=19092
REDPANDA_ADMIN_PORT=9644
REDPANDA_CONSOLE_PORT=8080

# ---------------------------------------------------------------------------
# Redis (job queues)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Object storage (MinIO, S3-compatible)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=continuum
MINIO_ROOT_PASSWORD=continuum-local-dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=continuum
S3_SECRET_ACCESS_KEY=continuum-local-dev
S3_BUCKET_DOCUMENTS=continuum-documents
S3_BUCKET_MODELS=continuum-models
# MinIO requires path-style addressing; real S3 does not.
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Embedding model
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---------------------------------------------------------------------------
# Drift detection
# ---------------------------------------------------------------------------
DRIFT_THRESHOLD=0.08
# Width of the short drift window, and how often the worker checks whether one has closed.
# Windows tumble on this boundary, so it also sets how quickly a distribution shift is
# visible. Raising it makes each centroid steadier; lowering it below ~30s puts the window
# centroid inside the measured within-domain noise and the threshold stops separating.
DRIFT_WINDOW_SECONDS=40
DRIFT_POLL_SECONDS=5
LINGUISTIC_DRIFT_THRESHOLD=0.65
LINGUISTIC_DRIFT_WINDOW_MINUTES=2
LINGUISTIC_DRIFT_POLL_SECONDS=30
DRIFT_TRIGGER_MIN_DOCUMENTS=100
DRIFT_TRIGGER_MIN_EMBEDDING_DRIFT=0.08
DRIFT_TRIGGER_MIN_LINGUISTIC_DRIFT=0.60
DRIFT_TRIGGER_COOLDOWN_HOURS=6
DRIFT_TRIGGER_MAX_DAILY_TRAINS=3
# Minimum retrieval-quality gain before a candidate model can be activated.
ACTIVATION_MIN_IMPROVEMENT=0.10

# ---------------------------------------------------------------------------
# Trainer
# ---------------------------------------------------------------------------
# demo_adapter keeps the local demo lightweight. Set to peft for genuine LoRA
# fine-tuning with torch/transformers/peft/optimum.
TRAINER_BACKEND=peft
RETRAIN_COOLDOWN_MINUTES=10
TRAINING_RETRY_BASE_SECONDS=1.0

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_SERVICE_NAME=continuum
# Traces are dropped when this is unset, which is the default for local runs.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# API auth and operations
# ---------------------------------------------------------------------------
# Prefer API_KEY_BCRYPT_HASH outside local development. Generate one with:
# uv run python -c "from continuum_shared.security import hash_api_key; print(hash_api_key('replace-me'))"
API_KEY=continuum-secret-key
API_KEY_BCRYPT_HASH=
RETENTION_CLEANUP_INTERVAL_SECONDS=86400
RETENTION_EMBEDDINGS_DAYS=90
RETENTION_DRIFT_WINDOWS_DAYS=30
RETENTION_TRAINING_JOBS_DAYS=365
ROLLBACK_ERROR_RATE_THRESHOLD=0.05
ROLLBACK_WINDOW_SECONDS=300
ROLLBACK_MIN_REQUESTS=100
