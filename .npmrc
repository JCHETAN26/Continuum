# Fail fast if the local Node/pnpm version does not match package.json engines.
engine-strict=true

# Workspace packages always resolve to the local copy, never the registry.
link-workspace-packages=true
prefer-workspace-packages=true

# Peer dependencies are installed automatically but conflicts are surfaced, not hidden.
auto-install-peers=true
strict-peer-dependencies=false
engine-strict=false
